/* 初中语法专题 (Grammar Topics) */
.grammar-page {
  max-width: 1240px;
  margin: 0 auto;
  padding: 22px clamp(12px, 2vw, 30px) 48px;
}

.grammar-headline {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}
.grammar-eyebrow {
  color: var(--green, #176b4d);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 2.2px;
  text-transform: uppercase;
}
.grammar-headline h1 {
  font-size: 30px;
  letter-spacing: -0.5px;
  color: var(--ink, #17231f);
  margin: 4px 0 4px;
}
.grammar-sub {
  color: var(--muted, #6d7b75);
  margin: 0 0 14px;
  font-size: 13px;
  max-width: 760px;
}
.grammar-sub em {
  font-style: normal;
  color: var(--green-dark, #0d4f39);
  font-weight: 750;
}
.grammar-progress {
  min-width: 150px;
  padding: 12px 16px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.82);
  text-align: center;
}
.grammar-progress .gp-num {
  color: var(--green-dark, #0d4f39);
  font-size: 24px;
  font-weight: 850;
  line-height: 1.1;
}
.grammar-progress .gp-num span {
  font-size: 13px;
  font-weight: 650;
  color: var(--muted, #6d7b75);
}
.grammar-progress .gp-label {
  color: var(--muted, #6d7b75);
  font-size: 11px;
  margin-bottom: 6px;
}
.grammar-progress .gp-bar {
  height: 6px;
  border-radius: 999px;
  background: #e6efe9;
  overflow: hidden;
}
.grammar-progress .gp-bar i {
  display: block;
  height: 100%;
  background: var(--green, #176b4d);
  border-radius: 999px;
  transition: width 0.3s;
}

.grammar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin: 18px 0 10px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 14px;
}
.grammar-cats {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 4px;
  background: #f0f5f2;
  border-radius: 12px;
}
.grammar-cats button {
  padding: 8px 16px;
  border: none;
  background: transparent;
  color: var(--muted, #6d7b75);
  font-size: 13px;
  font-weight: 650;
  border-radius: 9px;
  cursor: pointer;
}
.grammar-cats button.active {
  background: #fff;
  color: var(--green-dark, #0d4f39);
  font-weight: 800;
}
.grammar-search input {
  width: min(320px, 60vw);
  padding: 10px 14px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 10px;
  font-size: 13px;
  background: #fff;
  color: var(--ink, #17231f);
}
.grammar-search input:focus {
  outline: 2px solid rgba(23, 107, 77, 0.25);
  outline-offset: 1px;
}

.grammar-source-note {
  margin: 0 0 16px;
  padding: 10px 14px;
  border-left: 3px solid var(--green, #176b4d);
  background: #f3f8f5;
  border-radius: 0 10px 10px 0;
  color: var(--muted, #5c6b64);
  font-size: 12px;
}

.grammar-layout {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

.grammar-nav {
  position: sticky;
  top: 16px;
  max-height: calc(100vh - 40px);
  overflow: auto;
  padding: 12px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.86);
}
.gnav-label {
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 1.5px;
  color: var(--muted, #7b8a83);
  margin: 12px 6px 6px;
}
.grammar-nav-group:first-child .gnav-label {
  margin-top: 2px;
}
.gnav-item {
  display: block;
  width: 100%;
  padding: 9px 10px;
  margin-bottom: 4px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.gnav-item:hover {
  background: #f2f7f4;
}
.gnav-item.active {
  background: #e9f4ee;
  border-color: rgba(23, 107, 77, 0.28);
}
.gnav-name {
  display: block;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink, #17231f);
  margin-bottom: 5px;
}
.gnav-item.active .gnav-name {
  color: var(--green-dark, #0d4f39);
}
.gnav-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.gnav-count {
  font-size: 11px;
  color: var(--muted, #7b8a83);
  white-space: nowrap;
}
.gnav-bar {
  flex: 1;
  height: 4px;
  border-radius: 999px;
  background: #e6efe9;
  overflow: hidden;
}
.gnav-bar i {
  display: block;
  height: 100%;
  background: var(--green, #176b4d);
}

.grammar-detail {
  min-width: 0;
  padding: clamp(16px, 2.4vw, 26px);
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 10px 30px rgba(23, 61, 46, 0.05);
}
.gd-tags {
  display: flex;
  align-items: center;
  gap: 10px;
}
.gd-cat {
  padding: 3px 10px;
  border-radius: 999px;
  background: #e9f4ee;
  color: var(--green-dark, #0d4f39);
  font-size: 11px;
  font-weight: 800;
}
.gd-level {
  color: #d9922b;
  font-size: 12px;
  letter-spacing: 1px;
}
.gd-head h2 {
  margin: 10px 0 6px;
  font-size: 24px;
  color: var(--ink, #17231f);
}
.gd-summary {
  margin: 0 0 12px;
  color: #45534c;
  font-size: 14px;
  line-height: 1.75;
}
.gd-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}
.gd-links-label {
  font-size: 11px;
  font-weight: 800;
  color: var(--muted, #7b8a83);
}
.gd-link {
  padding: 4px 10px;
  border-radius: 999px;
  background: #f3f6f4;
  border: 1px solid var(--line, #dfe8e2);
  font-size: 11.5px;
  color: #4a5a53;
}
.gd-spread {
  margin: 0;
  font-size: 12px;
  color: var(--muted, #7b8a83);
}

.gd-block {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px dashed var(--line, #dfe8e2);
}
.gd-block h3 {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 12px;
  font-size: 15px;
  color: var(--ink, #17231f);
}
.sec-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green, #176b4d);
}

.gd-forms {
  display: grid;
  gap: 10px;
}
.gd-form {
  padding: 12px 14px;
  border-radius: 12px;
  background: #f7faf8;
  border: 1px solid var(--line, #e6efe9);
}
.gd-form-name {
  font-size: 12px;
  font-weight: 800;
  color: var(--green-dark, #0d4f39);
  margin-bottom: 6px;
}
.gd-form-pattern {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  color: #1f4636;
  background: #fff;
  border: 1px solid #e2ece6;
  border-radius: 8px;
  padding: 8px 10px;
  word-break: break-word;
}
.gd-form-note {
  margin-top: 6px;
  font-size: 11.5px;
  color: var(--muted, #7b8a83);
}

.gd-points {
  display: grid;
  gap: 14px;
}
.gd-point {
  padding: 14px;
  border-left: 3px solid rgba(23, 107, 77, 0.35);
  background: #fbfdfc;
  border-radius: 0 12px 12px 0;
}
.gd-point h4 {
  margin: 0 0 4px;
  font-size: 14px;
  color: var(--green-dark, #0d4f39);
}
.gd-point-desc {
  margin: 0 0 8px;
  font-size: 13px;
  color: #4a5a53;
  line-height: 1.7;
}
.gd-examples {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 6px;
}
.gd-examples li {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  font-size: 13px;
  line-height: 1.6;
  padding: 6px 8px;
  border-radius: 8px;
}
.gd-examples li.good {
  background: #f1f8f3;
  color: #1d4a37;
  cursor: pointer;
}
.gd-examples li.bad {
  background: #fdf3f2;
  color: #8b3a33;
}
.ex-ico {
  flex: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.ex-ico.ok {
  background: #d8ecdf;
  color: #1d6b45;
}
.ex-ico.no {
  background: #f6dcd9;
  color: #a4443a;
}

.gd-contrast {
  margin-bottom: 12px;
}
.gd-contrast-title {
  font-size: 12.5px;
  font-weight: 750;
  color: #45534c;
  margin-bottom: 6px;
}
.gd-contrast table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
.gd-contrast th,
.gd-contrast td {
  border: 1px solid var(--line, #e6efe9);
  padding: 8px 10px;
  text-align: left;
  vertical-align: top;
}
.gd-contrast th {
  background: #f3f8f5;
  color: var(--green-dark, #0d4f39);
  font-weight: 800;
}

.gd-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
.gd-two-col > div {
  min-width: 0;
}
.gd-plain {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 6px;
  font-size: 12.5px;
  color: #4a5a53;
  line-height: 1.65;
}
.gd-plain.exam li::marker {
  color: var(--green, #176b4d);
}

.gd-memory {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.gd-memory span {
  padding: 8px 14px;
  border-radius: 10px;
  background: linear-gradient(120deg, #eef7f1, #f7fbf8);
  border: 1px solid #dcebe2;
  font-size: 13px;
  font-weight: 700;
  color: #1d4a37;
}

.gd-practice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.gd-practice-head h3 {
  margin: 0;
}
.gd-practice-meta {
  font-size: 12px;
  color: var(--muted, #7b8a83);
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.gd-reset {
  padding: 4px 12px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 8px;
  background: #fff;
  color: var(--green-dark, #0d4f39);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.gd-question {
  padding: 14px;
  margin-bottom: 12px;
  border: 1px solid var(--line, #e6efe9);
  border-radius: 14px;
  background: #fff;
}
.gd-q-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.gd-q-no {
  font-size: 12px;
  font-weight: 850;
  color: var(--green-dark, #0d4f39);
}
.gd-q-src {
  font-size: 11px;
  color: var(--muted, #8a978f);
}
.gd-q-badge {
  flex: none;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.3px;
}
.gd-q-badge.exam {
  background: #e7f2ec;
  color: #0d5b3e;
}
.gd-q-badge.exam-other {
  background: #e8eefb;
  color: #2b4c8c;
}
.gd-q-badge.adapted {
  background: #fdf3e3;
  color: #9a6414;
}
.gd-q-badge.authored {
  background: #eef0f2;
  color: #5a6672;
}
.gd-q-point {
  margin-left: auto;
  padding: 2px 8px;
  border-radius: 6px;
  background: #f2f5f3;
  color: #55655d;
  font-size: 10.5px;
  font-weight: 700;
  white-space: nowrap;
}
.gd-q-stem {
  margin: 0 0 10px;
  font-size: 14px;
  line-height: 1.75;
  color: #22322b;
}
.gd-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 8px;
}
.gd-option {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 10px;
  background: #fff;
  font-size: 13.5px;
  color: var(--ink, #17231f);
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.gd-option:not(:disabled):hover {
  border-color: rgba(23, 107, 77, 0.45);
  background: #f6fbf8;
}
.gd-option:disabled {
  cursor: default;
}
.gd-option.correct {
  border-color: #4ca97b;
  background: #ecf8f1;
}
.gd-option.wrong {
  border-color: #d98b83;
  background: #fdf2f0;
}
.gd-option.muted {
  opacity: 0.62;
}
.gd-opt-letter {
  flex: none;
  width: 20px;
  height: 20px;
  border-radius: 6px;
  background: #eef3f0;
  color: #3d4f47;
  font-size: 11px;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.gd-option.correct .gd-opt-letter {
  background: #4ca97b;
  color: #fff;
}
.gd-option.wrong .gd-opt-letter {
  background: #d98b83;
  color: #fff;
}
.gd-opt-text {
  min-width: 0;
}

.gd-feedback {
  margin-top: 10px;
  padding: 12px 14px;
  border-radius: 12px;
  font-size: 13px;
}
.gd-feedback.right {
  background: #f0f9f4;
  border: 1px solid #cfe9db;
}
.gd-feedback.wrong {
  background: #fdf4f3;
  border: 1px solid #f0d3cf;
}
.gd-answer-line {
  display: flex;
  gap: 12px;
  align-items: baseline;
  margin-bottom: 6px;
}
.gd-answer-line b {
  color: var(--green-dark, #0d4f39);
}
.gd-feedback.wrong .gd-answer-line b {
  color: #a4443a;
}
.gd-answer-line span {
  font-size: 12px;
  color: #5c6b64;
}
.gd-explanation {
  margin: 0;
  color: #445049;
  line-height: 1.8;
}
.gd-answer-source {
  margin: 8px 0 0;
  padding-top: 8px;
  border-top: 1px dashed rgba(93, 116, 105, 0.28);
  font-size: 11.5px;
  color: #7b8a83;
  line-height: 1.6;
}

.gd-textbook-ex {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
}
.gd-textbook-ex li {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #f7faf8;
  border: 1px solid var(--line, #e6efe9);
  cursor: pointer;
}
.gd-textbook-ex li:hover {
  background: #f1f8f4;
}
.tb-en {
  font-size: 13.5px;
  font-weight: 650;
  color: #1d4a37;
}
.tb-zh {
  font-size: 12.5px;
  color: #5c6b64;
}
.tb-src {
  margin-left: auto;
  font-size: 11px;
  color: #8a978f;
  white-space: nowrap;
}

.grammar-empty {
  padding: 24px;
  text-align: center;
  color: var(--muted, #8a978f);
  font-size: 13px;
}

/* 课程学习页 → 语法专题 入口 */
.grammar-jump {
  display: block;
  width: 100%;
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px dashed rgba(23, 107, 77, 0.4);
  border-radius: 12px;
  background: #f5faf7;
  color: var(--green-dark, #0d4f39);
  font-size: 13px;
  font-weight: 750;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.grammar-jump:hover {
  background: #ecf6f0;
  border-color: rgba(23, 107, 77, 0.65);
}

/* 智能学习台 · 语法专项推荐 */
.smart-grammar {
  margin-top: 20px;
  padding: 20px;
  border: 1px solid var(--line, #dfe8e2);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.88);
}
.smart-grammar header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.smart-grammar header span {
  display: block;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 1.8px;
  color: var(--green, #176b4d);
}
.smart-grammar header h2 {
  margin: 4px 0 0;
  font-size: 19px;
  color: var(--ink, #17231f);
}
.smart-grammar header small {
  font-size: 12px;
  color: var(--muted, #6d7b75);
}
.smart-grammar-tip {
  margin: 8px 0 14px;
  font-size: 12.5px;
  color: var(--muted, #6d7b75);
}
.smart-grammar-list {
  display: grid;
  gap: 8px;
}
.smart-grammar-list button {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(60px, 1fr) auto;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 11px 14px;
  border: 1px solid var(--line, #e6efe9);
  border-radius: 12px;
  background: #fbfdfc;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.smart-grammar-list button:hover {
  background: #f1f8f4;
  border-color: rgba(23, 107, 77, 0.4);
}
.smart-grammar-list b {
  display: block;
  font-size: 13.5px;
  color: var(--ink, #17231f);
}
.smart-grammar-list span {
  display: block;
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--muted, #7b8a83);
}
.smart-grammar-list i {
  display: block;
  height: 6px;
  border-radius: 999px;
  background: #e6efe9;
  overflow: hidden;
}
.smart-grammar-list i u {
  display: block;
  height: 100%;
  background: var(--green, #176b4d);
  text-decoration: none;
}
.smart-grammar-list strong {
  font-size: 12.5px;
  color: var(--green-dark, #0d4f39);
}
.smart-grammar-more {
  margin-top: 14px;
  padding: 10px 16px;
  border: 1px solid rgba(23, 107, 77, 0.35);
  border-radius: 10px;
  background: #fff;
  color: var(--green-dark, #0d4f39);
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
}
.smart-grammar-more:hover {
  background: #eff8f3;
}

/* ---- yufan 教材讲义（讲义精讲） ---- */
.gd-lecture .gd-lecture-src {
  margin-left: 8px;
  font-style: normal;
  font-weight: 600;
  font-size: 11px;
  color: var(--muted, #6d7b75);
}
.gd-lecture-intro {
  margin: 8px 0 16px;
  padding: 10px 14px;
  border-left: 3px solid var(--green, #176b4d);
  background: #f4faf6;
  border-radius: 0 10px 10px 0;
  color: var(--ink, #17231f);
  font-size: 13.5px;
  line-height: 1.75;
}
.gd-lecture-loading {
  margin: 8px 0 16px;
  padding: 10px 14px;
  border-radius: 10px;
  background: #f4faf6;
  color: var(--muted, #6d7b75);
  font-size: 13px;
}
.gd-lecture-error {
  margin: 8px 0 16px;
  padding: 10px 14px;
  border-radius: 10px;
  background: #fff4f4;
  color: #8b2f2f;
  font-size: 13px;
}
.gd-lecture-retry {
  margin-left: 6px;
  padding: 2px 10px;
  border: 1px solid currentColor;
  border-radius: 999px;
  background: transparent;
  color: inherit;
  font-size: 12px;
  cursor: pointer;
}
.gd-lec-section {
  margin: 0 0 18px;
}
.gd-lec-section > h4 {
  margin: 0 0 9px;
  padding-bottom: 5px;
  border-bottom: 1px dashed var(--line, #dfe8e2);
  color: var(--green-dark, #0d4f39);
  font-size: 14px;
  font-weight: 800;
}
.gd-lec-text {
  margin: 0 0 9px;
  color: var(--ink, #17231f);
  font-size: 13.5px;
  line-height: 1.75;
}
.gd-lec-list {
  margin: 0 0 10px;
  padding-left: 0;
  list-style: none;
}
.gd-lec-list li {
  position: relative;
  margin-bottom: 5px;
  padding-left: 18px;
  font-size: 13.5px;
  line-height: 1.7;
}
.gd-lec-list li::before {
  content: "▸";
  position: absolute;
  left: 2px;
  color: var(--green, #176b4d);
  font-weight: 800;
}
.gd-lec-ex {
  margin: 0 0 10px;
  padding-left: 0;
  list-style: none;
}
.gd-lec-ex li {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6px 10px;
  margin-bottom: 6px;
  padding: 6px 10px;
  border-radius: 8px;
  background: #f7fbf9;
  cursor: pointer;
}
.gd-lec-ex li:hover {
  background: #eef8f2;
}
.gd-lec-ex .tb-en {
  color: var(--green-dark, #0d4f39);
  font-weight: 650;
}
.gd-lec-ex .tb-zh {
  color: var(--muted, #6d7b75);
  font-size: 12.5px;
}
.gd-lec-table {
  margin: 0 0 12px;
  overflow-x: auto;
}
.gd-lec-table table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
.gd-lec-table th,
.gd-lec-table td {
  border: 1px solid var(--line, #dfe8e2);
  padding: 6px 9px;
  text-align: left;
  vertical-align: top;
}
.gd-lec-table thead th {
  background: #eff6f1;
  color: var(--green-dark, #0d4f39);
  font-weight: 800;
  white-space: nowrap;
}
.gd-lec-tip,
.gd-lec-pitfall {
  margin: 0 0 9px;
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 13px;
  line-height: 1.7;
}
.gd-lec-tip {
  border-left: 3px solid #3b82f6;
  background: #edf6ff;
}
.gd-lec-pitfall {
  border-left: 3px solid #f59e0b;
  background: #fff6ed;
}
.gd-lec-tip b,
.gd-lec-pitfall b {
  margin-right: 6px;
  color: var(--green-dark, #0d4f39);
}

@media (max-width: 620px) {
  .smart-grammar-list button {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .smart-grammar-list i {
    display: none;
  }
}

@media (max-width: 900px) {
  .grammar-layout {
    grid-template-columns: 1fr;
  }
  .grammar-nav {
    position: static;
    max-height: none;
    display: flex;
    gap: 14px;
    overflow-x: auto;
  }
  .grammar-nav-group {
    flex: none;
    min-width: 170px;
  }
  .gd-two-col {
    grid-template-columns: 1fr;
  }
  .grammar-headline h1 {
    font-size: 24px;
  }
}

/* =========================================================================
   语法专题 2.0（2026-09-27）
   命名空间 gr2-*：只服务 GrammarView 新布局，不改动 .smart-grammar*、.grammar-jump
   等仍被 SmartLearningView / CourseView 复用的旧类。
   结构见 docs/grammar-redesign-plan.md §6：A 专题头 / B 速查 / C 讲义 / D 用法 /
   E 易错考法 / F 记忆卡例句 / G 练习，右侧页内 TOC。
   ========================================================================= */
.gr2-page {
  --gr2-green: var(--green, #176b4d);
  --gr2-green-dark: var(--green-dark, #0d4f39);
  --gr2-ink: var(--ink, #17231f);
  --gr2-muted: var(--muted, #6d7b75);
  --gr2-line: var(--line, #dfe8e2);
  --gr2-blue: #2563eb;
  --gr2-amber: #b45309;
  --gr2-red: #c0392b;
}
.gr2-eyebrow {
  margin: 0 0 8px;
  color: var(--gr2-green);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 2.2px;
  text-transform: uppercase;
}

/* ---------- A 专题头 ---------- */
.gr2-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22px;
  flex-wrap: wrap;
  padding: 16px 18px;
  border: 1px solid var(--gr2-line);
  border-radius: 16px;
  background: #fff;
}
.gr2-head-main { min-width: 0; flex: 1 1 520px; }
.gr2-crumb { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--gr2-muted); }
.gr2-crumb button {
  border: 0;
  background: transparent;
  padding: 0;
  font: inherit;
  color: var(--gr2-green-dark);
  font-weight: 700;
  cursor: pointer;
}
.gr2-crumb b { color: var(--gr2-ink); font-weight: 700; }
.gr2-title-row { position: relative; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 6px 0 0; }
.gr2-title-row h1 { margin: 0; font-size: 27px; letter-spacing: -0.5px; color: var(--gr2-ink); }
.gr2-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 9px;
  border: 1px solid var(--gr2-line);
  border-radius: 999px;
  background: #f7faf8;
  color: #46685a;
  font-size: 11.5px;
  font-weight: 700;
  white-space: nowrap;
}
.gr2-chip.hot { border-color: #bfe3d2; background: #e9f6ef; color: var(--gr2-green-dark); }
.gr2-chip.is-state { border-color: #c9daff; background: #eef3ff; color: #1d4ed8; }
.gr2-sum { margin: 8px 0 10px; max-width: 760px; color: #4c5f57; font-size: 13.5px; }
.gr2-metrics { display: flex; flex-wrap: wrap; gap: 20px; }
.gr2-metrics > div { display: flex; flex-direction: column; }
.gr2-metrics b { font-size: 17px; color: var(--gr2-ink); line-height: 1.3; }
.gr2-metrics span { font-size: 11.5px; color: var(--gr2-muted); }
.gr2-head-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
.gr2-btn {
  border: 1px solid var(--gr2-line);
  border-radius: 10px;
  background: #fff;
  padding: 7px 13px;
  font: inherit;
  font-size: 12.5px;
  font-weight: 700;
  color: #33513f;
  cursor: pointer;
}
.gr2-btn:hover:not(:disabled) { border-color: #bcd6c8; background: #f6faf8; }
.gr2-btn:disabled { opacity: 0.55; cursor: not-allowed; }
.gr2-btn.primary { background: var(--gr2-green); border-color: var(--gr2-green); color: #fff; }
.gr2-btn.primary:hover:not(:disabled) { background: var(--gr2-green-dark); }
.gr2-btn.tiny { padding: 3px 9px; font-size: 11.5px; font-weight: 600; }
.gr2-mini { min-width: 148px; position: relative; padding-bottom: 8px; font-size: 11.5px; color: var(--gr2-muted); }
.gr2-mini b { color: var(--gr2-ink); font-size: 13px; }
.gr2-mini-label { margin-right: 6px; }
.gr2-mini i {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4px;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--gr2-green), #7cc5a2);
  min-width: 3px;
}
.gr2-note {
  margin-top: 12px;
  padding: 12px 16px;
  border: 1px dashed #b9cfc4;
  border-radius: 12px;
  background: #fbfdfc;
  font-size: 12.5px;
  color: #46685a;
}
.gr2-note b { display: block; margin-bottom: 4px; color: var(--gr2-ink); }
.gr2-note ul { margin: 0 0 6px; padding-left: 18px; }
.gr2-note p { margin: 0 0 8px; }

/* ---------- 三栏骨架 ---------- */
.gr2-layout {
  display: grid;
  grid-template-columns: 268px minmax(0, 1fr) 196px;
  gap: 16px;
  margin-top: 14px;
  align-items: start;
}
/* ---------- 二级导航（专题树） ---------- */
.gr2-nav {
  position: sticky;
  top: 12px;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 28px);
  border: 1px solid var(--gr2-line);
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}
.gr2-nav:focus-visible { outline: 2px solid var(--gr2-green); outline-offset: 2px; }
.gr2-nav-head { padding: 10px; border-bottom: 1px solid var(--gr2-line); display: flex; flex-direction: column; gap: 8px; }
.gr2-cats { display: flex; flex-wrap: wrap; gap: 5px; }
.gr2-cats button {
  border: 1px solid transparent;
  border-radius: 999px;
  background: #f1f6f3;
  color: #4a6b5c;
  padding: 3px 9px;
  font: inherit;
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
}
.gr2-cats button small { opacity: 0.55; font-weight: 700; margin-left: 2px; }
.gr2-cats button.on { background: #12362a; color: #fff; }
.gr2-tools { display: flex; gap: 6px; }
.gr2-tools input {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--gr2-line);
  border-radius: 9px;
  padding: 6px 9px;
  font: inherit;
  font-size: 12.5px;
}
.gr2-tools input:focus { outline: 2px solid #cfe6da; border-color: var(--gr2-green); }
.gr2-tools select {
  border: 1px solid var(--gr2-line);
  border-radius: 9px;
  padding: 6px 4px;
  font: inherit;
  font-size: 12px;
  color: #33513f;
  background: #fff;
}
.gr2-nav-list { overflow: auto; padding: 8px; display: flex; flex-direction: column; gap: 2px; }
.gr2-group > header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 7px;
  font-size: 11.5px;
  font-weight: 850;
  letter-spacing: 0.4px;
  color: #5c7a6b;
  cursor: pointer;
  user-select: none;
}
.gr2-group > header i { font-style: normal; transition: transform 0.15s; }
.gr2-group > header i.closed { transform: rotate(-90deg); }
.gr2-group > header em { margin-left: auto; font-style: normal; font-weight: 700; font-size: 10.5px; color: #93aca1; }
.gr2-group-body { display: flex; flex-direction: column; gap: 1px; }
.gr2-sub { padding: 6px 8px 2px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.6px; color: #8aa79a; }
.gr2-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  border: 0;
  border-radius: 10px;
  background: transparent;
  padding: 7px 8px;
  font: inherit;
  text-align: left;
  color: var(--gr2-ink);
  cursor: pointer;
}
.gr2-item:hover { background: #f2f7f4; }
.gr2-item.on { background: #e9f4ee; font-weight: 800; }
.gr2-item.on::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6px;
  bottom: 6px;
  width: 3px;
  border-radius: 3px;
  background: var(--gr2-green);
}
.gr2-item-name { flex: 1; min-width: 0; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gr2-item-meta {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 56%;
  font-size: 10.5px;
  font-weight: 700;
  color: var(--gr2-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.gr2-item.st-lecture .gr2-item-meta { color: #6b8f7e; }
.gr2-item.st-exonly .gr2-item-meta { color: var(--gr2-blue); }
.gr2-item.st-empty .gr2-item-meta { color: #a4b3ac; }
.gr2-item.st-done .gr2-item-meta { color: var(--gr2-green); }
.gr2-ring {
  flex: 0 0 14px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: conic-gradient(var(--gr2-green) var(--p, 0%), #e3ece7 0);
}
.gr2-empty { padding: 10px; margin: 0; font-size: 12px; color: var(--gr2-muted); }
.gr2-nav-foot { border-top: 1px solid var(--gr2-line); background: #fafdfb; padding: 9px 10px; }
.gr2-nav-foot > div { display: inline-flex; flex-direction: column; vertical-align: middle; max-width: 62%; }
.gr2-nav-foot b { font-size: 12.5px; }
.gr2-nav-foot small { font-size: 11px; color: var(--gr2-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gr2-nav-foot .gr2-btn { float: right; margin-top: 3px; }

/* ---------- 正文区 ---------- */
.gr2-detail { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.gr2-block {
  border: 1px solid var(--gr2-line);
  border-radius: 16px;
  background: #fff;
  padding: 14px 16px;
  scroll-margin-top: 14px;
}
.gr2-block > h2 {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin: 0 0 12px;
  font-size: 15px;
  color: var(--gr2-ink);
}
.gr2-block > h2 em { font-style: normal; font-size: 11.5px; font-weight: 600; color: var(--gr2-muted); }
.gr2-block > h2 .gr2-btn { margin-left: auto; }
.gr2-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gr2-green); flex: 0 0 7px; }
.gr2-hint { margin: 0; padding: 10px 12px; border-radius: 10px; background: #f7faf8; color: #54746a; font-size: 12.5px; }
.gr2-hint.error { background: #fdf3f2; color: #9c3227; }
.gr2-table-wrap { overflow-x: auto; }
/* ---------- B 速查 ---------- */
.gr2-forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; }
.gr2-form { border: 1px solid var(--gr2-line); border-radius: 12px; background: #fbfdfc; padding: 10px 12px; }
.gr2-form b { display: block; margin-bottom: 5px; font-size: 12.5px; color: var(--gr2-ink); }
.gr2-form code {
  display: block;
  padding: 6px 8px;
  border-radius: 7px;
  background: #eef4f1;
  color: #1f4636;
  font-size: 12px;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  word-break: break-word;
}
.gr2-form small { display: block; margin-top: 5px; font-size: 11.5px; color: var(--gr2-muted); }
.gr2-contrast { margin-top: 12px; }
.gr2-contrast h3 { margin: 0 0 6px; font-size: 13px; color: #33513f; }
.gr2-block table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.gr2-block th, .gr2-block td { border-bottom: 1px solid var(--gr2-line); padding: 6px 8px; text-align: left; vertical-align: top; }
.gr2-block thead th { background: #f6faf8; font-size: 11.5px; color: #4a6b5c; white-space: nowrap; }
.gr2-block tbody tr:hover td { background: #fbfdfc; }

/* ---------- C 讲义精讲（分节折叠） ---------- */
.gr2-lec-intro { margin: 0 0 10px; padding: 10px 12px; border-radius: 10px; background: #f6faf8; font-size: 12.5px; color: #46685a; }
.gr2-lec { border: 1px solid var(--gr2-line); border-radius: 12px; margin-bottom: 8px; overflow: hidden; scroll-margin-top: 14px; }
.gr2-lec > header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  background: #fbfdfc;
  cursor: pointer;
  user-select: none;
}
.gr2-lec > header i { font-style: normal; color: #7f9a8f; transition: transform 0.15s; }
.gr2-lec.open > header i { transform: rotate(90deg); }
.gr2-lec > header h3 { margin: 0; font-size: 13.5px; font-weight: 750; color: var(--gr2-ink); }
.gr2-lec-no { margin-left: auto; font-size: 10.5px; font-weight: 700; color: #93aca1; white-space: nowrap; }
.gr2-lec-body { padding: 6px 14px 12px; border-top: 1px solid var(--gr2-line); }
.gr2-lec-text { margin: 8px 0; font-size: 13px; line-height: 1.75; color: #2c3f38; }
.gr2-lec-list { margin: 8px 0; padding-left: 20px; font-size: 12.5px; color: #2c3f38; }
.gr2-lec-list li { margin: 4px 0; }
.gr2-lec-ex { list-style: none; margin: 8px 0; padding: 0; }
.gr2-lec-ex li { display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 6px; border-radius: 8px; cursor: pointer; font-size: 12.5px; }
.gr2-lec-ex li:hover { background: #f4f8f6; }
.gr2-en { color: #17231f; font-weight: 650; }
.gr2-zh { color: #6d7b75; }
.gr2-src { color: #a4b3ac; font-size: 11.5px; }
.gr2-lec-tip, .gr2-lec-pitfall { margin: 8px 0; padding: 8px 10px; border-radius: 9px; font-size: 12.5px; }
.gr2-lec-tip { background: #f5f8ff; border: 1px solid #c9daff; color: #24457f; }
.gr2-lec-pitfall { background: #fffaf1; border: 1px solid #f0dcb6; color: #8a5a12; }
.gr2-lec-tip b, .gr2-lec-pitfall b { margin-right: 6px; }

/* ---------- D 用法要点 ---------- */
.gr2-points { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; }
.gr2-point { border: 1px solid var(--gr2-line); border-radius: 12px; padding: 10px 12px; background: #fbfdfc; }
.gr2-point h3 { margin: 0 0 4px; font-size: 13px; color: var(--gr2-ink); }
.gr2-point-desc { margin: 0 0 6px; font-size: 12.5px; color: #4c5f57; }
.gr2-examples { list-style: none; margin: 0; padding: 0; }
.gr2-examples li { display: flex; gap: 7px; align-items: flex-start; padding: 3px 0; font-size: 12.5px; }
.gr2-examples li.good { color: #1f4636; cursor: pointer; }
.gr2-examples li.bad { color: #8d3a30; }
.gr2-ico { font-weight: 800; }
.gr2-ico.ok { color: var(--gr2-green); }
.gr2-ico.no { color: var(--gr2-red); }

/* ---------- E 易错与考法 ---------- */
.gr2-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; }
.gr2-card { border-radius: 12px; padding: 10px 12px; }
.gr2-card b { display: block; margin-bottom: 4px; font-size: 12.5px; }
.gr2-card ul { margin: 0; padding-left: 18px; font-size: 12.5px; }
.gr2-card ul li { margin: 3px 0; }
.gr2-card.warn { border: 1px solid #f0dcb6; background: #fffaf1; color: #8a5a12; }
.gr2-card.info { border: 1px solid #c9daff; background: #f5f8ff; color: #24457f; }

/* ---------- F 记忆卡与教材例句 ---------- */
.gr2-memory { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.gr2-memory span { padding: 3px 10px; border-radius: 999px; background: #12362a; color: #dff0e8; font-size: 11.5px; }
.gr2-tb { list-style: none; margin: 0; padding: 0; }
.gr2-tb li { display: flex; flex-wrap: wrap; gap: 8px; padding: 5px 6px; border-radius: 8px; cursor: pointer; font-size: 12.5px; }
.gr2-tb li:hover { background: #f4f8f6; }
/* ---------- G 专项练习（按来源题组） ---------- */
.gr2-qgroup { margin-bottom: 14px; }
.gr2-qgroup-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin: 0 0 8px;
  padding-bottom: 5px;
  border-bottom: 1px dashed var(--gr2-line);
}
.gr2-qgroup-head b { font-size: 13px; color: var(--gr2-ink); }
.gr2-qgroup-head span { font-size: 11.5px; color: var(--gr2-muted); }
.gr2-question { border: 1px solid var(--gr2-line); border-radius: 12px; padding: 11px 12px; margin-bottom: 9px; }
.gr2-q-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 11.5px; color: var(--gr2-muted); }
.gr2-q-no { font-weight: 800; color: #46685a; }
.gr2-q-point { padding: 1px 7px; border-radius: 999px; background: #f1f6f3; color: #4a6b5c; font-weight: 700; }
.gr2-q-stem { margin: 8px 0 0; font-size: 13.5px; line-height: 1.7; color: var(--gr2-ink); }
.gr2-options { display: grid; gap: 6px; margin-top: 8px; }
.gr2-option {
  display: flex;
  align-items: center;
  gap: 9px;
  border: 1px solid var(--gr2-line);
  border-radius: 10px;
  background: #fff;
  padding: 8px 10px;
  font: inherit;
  font-size: 13px;
  text-align: left;
  color: var(--gr2-ink);
  cursor: pointer;
}
.gr2-option:not(:disabled):hover { border-color: #bcd6c8; background: #f7fbf9; }
.gr2-option:disabled { cursor: default; }
.gr2-opt-letter {
  flex: 0 0 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: #f1f6f3;
  font-size: 11.5px;
  font-weight: 800;
  color: #4a6b5c;
}
.gr2-option.correct { border-color: #bfe3d2; background: #eef8f2; font-weight: 700; }
.gr2-option.correct .gr2-opt-letter { background: #cdebd9; color: var(--gr2-green-dark); }
.gr2-option.wrong { border-color: #f3c9c4; background: #fdf3f2; }
.gr2-option.wrong .gr2-opt-letter { background: #f6d9d5; color: #9c3227; }
.gr2-option.muted { opacity: 0.62; }
.gr2-feedback { margin-top: 9px; padding: 10px 12px; border-radius: 11px; font-size: 12.5px; }
.gr2-feedback.right { border: 1px solid #bfe3d2; background: #f4fbf7; }
.gr2-feedback.wrong { border: 1px solid #f3c9c4; background: #fdf7f6; }
.gr2-answer-line { display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; }
.gr2-answer-line b { color: var(--gr2-green-dark); }
.gr2-feedback.wrong .gr2-answer-line b { color: #9c3227; }
.gr2-answer-line span { color: #4c5f57; }
.gr2-explanation { margin: 6px 0 0; color: #2c3f38; line-height: 1.7; }
.gr2-answer-source { margin: 6px 0 0; color: var(--gr2-muted); font-size: 11.5px; }
.gr2-foot-nav { display: flex; justify-content: space-between; gap: 10px; padding: 4px 0 8px; }
.gr2-foot-nav button {
  border: 1px solid var(--gr2-line);
  border-radius: 10px;
  background: #fff;
  padding: 8px 14px;
  font: inherit;
  font-size: 12.5px;
  font-weight: 700;
  color: #33513f;
  cursor: pointer;
  max-width: 48%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gr2-foot-nav button:hover { border-color: #bcd6c8; background: #f6faf8; }

/* ---------- 页内目录 ---------- */
.gr2-toc {
  position: sticky;
  top: 12px;
  padding: 10px 8px;
  border: 1px solid var(--gr2-line);
  border-radius: 16px;
  background: #fff;
  max-height: calc(100vh - 28px);
  overflow: auto;
}
.gr2-toc h4 { margin: 0 0 6px; padding: 0 8px; font-size: 11px; letter-spacing: 1.2px; color: #8aa79a; }
.gr2-toc a {
  display: block;
  padding: 5px 9px;
  border-left: 2px solid transparent;
  border-radius: 8px;
  color: #41604f;
  font-size: 12px;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gr2-toc a.lv1 { font-weight: 800; color: var(--gr2-ink); }
.gr2-toc a.lv2 { padding-left: 20px; font-size: 11.5px; color: var(--gr2-muted); }
.gr2-toc a:hover { background: #f2f7f4; }
.gr2-toc a.on { background: #e9f4ee; border-left-color: var(--gr2-green); }

/* ---------- 响应式 ---------- */
@media (max-width: 1279px) {
  .gr2-layout { grid-template-columns: 252px minmax(0, 1fr); }
  .gr2-toc { display: none; }
}
@media (max-width: 960px) {
  .gr2-layout { grid-template-columns: minmax(0, 1fr); }
  .gr2-nav { position: static; max-height: none; }
  .gr2-nav-list { max-height: 46vh; }
  .gr2-head { padding: 14px; }
  .gr2-head-actions { align-items: stretch; width: 100%; }
  .gr2-head-actions .gr2-btn { width: 100%; }
  .gr2-mini { width: 100%; }
}
@media (max-width: 620px) {
  .gr2-page { padding-left: 12px; padding-right: 12px; }
  .gr2-title-row h1 { font-size: 23px; }
  .gr2-metrics { gap: 14px; }
  .gr2-block { padding: 12px; }
  .gr2-forms, .gr2-points, .gr2-two { grid-template-columns: 1fr; }
  .gr2-foot-nav button { max-width: 100%; }
}


/* ---------- 标题旁的说明按钮（原 spreadNote 长句改为 tooltip，不进正文） ---------- */
/* 弹层挂在 .gr2-title-row 上定位（整行宽），窄屏也不会溢出视口 */
.gr2-info-wrap { display: inline-flex; align-items: center; }
.gr2-info {
  width: 20px;
  height: 20px;
  padding: 0;
  border-radius: 50%;
  border: 1px solid var(--gr2-line);
  background: #fff;
  color: var(--gr2-muted);
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
}
.gr2-info:hover { border-color: #bcd6c8; color: var(--gr2-green-dark); background: #f2f8f5; }
.gr2-info.on { border-color: var(--gr2-green); color: var(--gr2-green-dark); background: #e9f6ef; }
.gr2-pop {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  z-index: 30;
  width: min(420px, 100%);
  padding: 10px 12px;
  border: 1px solid var(--gr2-line);
  border-radius: 12px;
  background: #fff;
  color: #3d4b45;
  font-size: 12.5px;
  line-height: 1.7;
  box-shadow: 0 12px 28px rgba(16, 44, 33, 0.14);
}
